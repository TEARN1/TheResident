# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Android TWA (Bubblewrap) — never commit a signing key. A leaked upload
# keystore cannot be revoked the way a password can; the fix is re-keying
# with Google Play App Signing, which is disruptive. The generated native
# project is also excluded: it's fully reproducible from twa-manifest.json
# via `npx @bubblewrap/cli init`, so keeping it out of git avoids two sources
# of truth drifting apart.
*.keystore
*.jks
key.properties
/android/
