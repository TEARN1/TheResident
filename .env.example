# ── The Resident Production Environment Template ─────────────────────────────────

# 1. Supabase Cloud Database & API Auth
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
# Required server-side by /api/payfast/itn to call res_apply_payfast_payment (service_role only)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# 2. Cryptographic Security & Session Secret Keys
JWT_SECRET=your-secure-random-256bit-jwt-secret-key-here
VOUCHER_SIGNING_KEY=your-landlord-hmac-sha256-secret-key-here

# 3. Hyperlocal Mapping & Tile Services (Optional)
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-access-token-optional
NEXT_PUBLIC_OSRM_ROUTING_URL=https://router.project-osrm.org

# 4. PayFast Payment Gateway (South Africa: Cards, Instant EFT, Capitec Pay, SnapScan)
# Sandbox defaults are shown below. For live payments, replace with your real PayFast
# Merchant ID, Merchant Key, and Passphrase from PayFast Dashboard -> Settings -> Developer Settings
# and remove PAYFAST_SANDBOX: live is the default, and it refuses to run without all three.
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=46f0cd694581a
PAYFAST_PASSPHRASE=jt7NOE43FZPn
PAYFAST_SANDBOX=true
